{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": false,
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "theme": {
    "mode": "dark",
    "name": "tokyonight"
  },
  "session": {
    "scrollbar": false,
    "sidebar": "auto",
    "markdown": "source",
    "grouping": "auto",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "on",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "diffs": {
    "view": "auto",
    "single": true,
    "wrap": "word",
    "tree": true
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "terminal": {
    "title": false,
    "copy": "select"
  },
  "debug": {
    "devtools": true,
    "timing": false,
    "turn_tokens": false
  },
  "prompt": {
    "paste": "compact"
  },
  "keybinds": {
    "agent.cycle": "shift+tab,tab"
  },
  "experimental": {
    "new-designs": true
  },
  "highlights": false
}
